createOrReplace

	expression WorkbookPath = "O:\De-Dashboard\sample_data\DeMillimanize Requests.mock.xlsx" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]

	expression Workbook =
			let
				// WorkbookPath can be a local/UNC file path or a SharePoint file URL (https://...).
				Source = if Text.StartsWith(WorkbookPath, "http", Comparer.OrdinalIgnoreCase)
					then Web.Contents(WorkbookPath)
					else File.Contents(WorkbookPath),
				Book = Excel.Workbook(Source, null, true)
			in
				Book

	table Requests

		column 'Ticket ID'
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: Ticket ID
			displayFolder: Ticket

		column 'Ticket URL'
			dataType: string
			summarizeBy: none
			sourceColumn: Ticket URL
			dataCategory: WebUrl
			displayFolder: Ticket

		column 'Created Date'
			dataType: dateTime
			formatString: mmm d, yyyy
			summarizeBy: none
			sourceColumn: Created Date
			displayFolder: Ticket

		column 'Requester Name'
			dataType: string
			summarizeBy: none
			sourceColumn: Requester Name
			displayFolder: People

		column 'Requester Email'
			dataType: string
			summarizeBy: none
			sourceColumn: Requester Email
			displayFolder: People

		column Department
			dataType: string
			summarizeBy: none
			sourceColumn: Department
			displayFolder: People

		column 'Computer Provided To'
			dataType: string
			summarizeBy: none
			sourceColumn: Computer Provided To
			displayFolder: People

		column 'Recipient Differs From Requester'
