		partition Requests = m
			mode: import
			source =
					let
						Source = Workbook{[Item="Requests", Kind="Table"]}[Data],
						Typed = Table.TransformColumnTypes(Source, {
											{"Ticket ID", Int64.Type},
											{"Ticket URL", type text},
											{"Created Date", type date},
											{"Requester Name", type text},
											{"Requester Email", type text},
											{"Department", type text},
											{"Computer Provided To", type text},
											{"Recipient Differs From Requester", type text},
											{"Requested For", type text},
											{"Outcome", type text},
											{"Outcome Source", type text},
											{"Outcome Evidence", type text},
											{"Approver", type text},
											{"Decision Date", type datetime},
											{"Device Type", type text},
											{"PC Make and Model", type text},
											{"PC Serial Number", type text},
											{"Most Recent PC Name", type text},
											{"Frequent (Requester)", type text},
											{"Requester Request #", Int64.Type},
											{"Days Since Previous (Requester)", Int64.Type},
											{"Frequent (Recipient)", type text},
											{"Recipient Request #", Int64.Type},
											{"Days Since Previous (Recipient)", Int64.Type},
											{"Same Serial Seen Before", type text},
											{"Holiday Season", type text},
											{"Certificate Attached", type text},
											{"Certificate File", type text},
											{"Certificate Missing", type text},
											{"Match Source", type text},
											{"Matched Phrase", type text},
											{"Matched Field", type text},
											{"Match Needs Review", type text},
											{"Ticket Type", type text},
											{"Status", type text},
											{"Item Stage", type text},
											{"Closed Date", type datetime},
											{"Subject", type text},
											{"Resolution Note", type text},
											{"Last Updated", type datetime},
											{"Requester Is Technician", type text},
											{"Recipient Is Technician", type text}
						}),
						Rows = Table.SelectRows(Typed, each [Ticket ID] <> null)
					in
						Rows

