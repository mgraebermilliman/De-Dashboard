			source =
					let
						Source = Workbook{[Item="People", Kind="Table"]}[Data],
						Typed = Table.TransformColumnTypes(Source, {
											{"Person", type text},
											{"Email", type text},
											{"Department", type text},
											{"Frequent", type text},
											{"Requests Made", Int64.Type},
											{"Requests Made For Others", Int64.Type},
											{"Times Named As Recipient", Int64.Type},
											{"Approved", Int64.Type},
											{"Denied", Int64.Type},
											{"Pending", Int64.Type},
											{"Needs Review", Int64.Type},
											{"First Request", type date},
